# OpenEventHub Environment Template
# Copy to `.env` before starting Compose. Never commit real secrets.

COMPOSE_PROJECT_NAME=openeventhub

# Public hostnames (Traefik routers)
DOMAIN=localhost
ACME_EMAIL=admin@example.com

# PostgreSQL (reachable as hostname `postgres` on the internal Docker network)
POSTGRES_USER=openeventhub
POSTGRES_PASSWORD=openeventhub_change_me
POSTGRES_DB=openeventhub
# Host DATABASE_URL only works with the optional dev-ports overlay (see below).
# Prefer: bash scripts/db-migrate.sh / db-seed.sh (attach to internal network).
DATABASE_URL=postgresql://openeventhub:openeventhub_change_me@localhost:15432/openeventhub

# Redis
REDIS_PASSWORD=redis_change_me

# Object storage (SeaweedFS S3 API) — see ADR 0004
# Internal endpoint used by containers: http://object-storage:8333
S3_ACCESS_KEY=openeventhub
S3_SECRET_KEY=openeventhub_change_me
S3_BUCKET=openeventhub
OBJECT_STORAGE_HOST=object-storage
OBJECT_STORAGE_PORT_INTERNAL=8333
# fs | s3 — Compose apps set s3; local tests may use fs
OBJECT_STORAGE_ADAPTER=s3
# Optional local FS root when OBJECT_STORAGE_ADAPTER=fs
# OBJECT_STORAGE_ROOT=/tmp/openeventhub-object-storage
# Optional override for crawler plugin discovery
# PLUGINS_DIR=/app/plugins

# Secrets used only for crypto/auth bootstrapping — NOT AI provider credentials.
# AI providers (ChatGPT, Claude, Gemini, Ollama, …) are configured in Admin → AI Settings.
# Optional bundled Ollama: OLLAMA_DEPLOY=1 (default). Set 0 to use an external Ollama via OLLAMA_BASE_URL.
SETTINGS_ENCRYPTION_KEY=dev-only-change-me-settings-key
AUTH_JWT_SECRET=dev-only-change-me-auth-jwt-secret
ADMIN_BOOTSTRAP_EMAIL=admin@openeventhub.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeNow!
OLLAMA_IMAGE=ollama/ollama:0.9.0
OLLAMA_MODEL=llama3.2
# Bundled Compose Ollama: 1 = deploy oeh-ollama | 0 = use an external LLM URL
OLLAMA_DEPLOY=1
# Seed / default Admin profile URL (must be reachable FROM api & ai-service containers).
# Hostname `ollama` only resolves when bundled Compose Ollama (OLLAMA_DEPLOY=1) is running.
# With an external Ollama on the host, use host.docker.internal (see docs/AI_CONFIGURATION.md).
# Bundled:              http://ollama:11434/v1
# Host 0.0.0.0:11434:   http://host.docker.internal:11434/v1
# LAN / remote:         http://192.168.1.50:11434/v1  or  https://llm.example.com/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Optional only: join a custom shared Docker network (no host publish). Leave unset normally.
# OLLAMA_EXTERNAL_NETWORK=my-llm-net
# OLLAMA_BASE_URL=http://ollama:11434/v1
# When OLLAMA_DEPLOY=1, prefer the bundled service DNS name instead:
# OLLAMA_BASE_URL=http://ollama:11434/v1
# OLLAMA_DEPLOY=1
# NVIDIA GPU for bundled Ollama only: auto | 1 | 0
OLLAMA_GPU=auto

# Admin UI → API (browser-facing via Traefik)
NEXT_PUBLIC_API_BASE_URL=http://api.localhost:8088
NEXT_PUBLIC_SITE_URL=http://localhost:8088
# Optional Admin white-label (rebuild Admin image after changing NEXT_PUBLIC_*)
# NEXT_PUBLIC_ADMIN_TITLE=FestSchmiede Admin
# NEXT_PUBLIC_ADMIN_LOGO_URL=/brand/mark.png
# Absolute portal URL embedded in calendar.ics event links (API feed)
PUBLIC_SITE_URL=http://localhost:8088
# Server-side frontend → API on the edge Docker network
API_INTERNAL_URL=http://api:3000

# API rate limiting (requests per TTL window)
API_RATE_LIMIT=120
API_RATE_LIMIT_TTL_MS=60000

# Traefik — only published host ports (Frontend / Admin / API / Grafana via Host headers)
TRAEFIK_HTTP_PORT=8088
TRAEFIK_HTTPS_PORT=8443

LOG_LEVEL=info
NODE_ENV=development
SERVICE_VERSION=0.26.1

# Browser origins allowed to call the API (Admin UI, Frontend)
CORS_ORIGINS=http://localhost:8088,http://admin.localhost:8088

# Admin region place lookup (OpenStreetMap Nominatim; DE only)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=OpenEventHub/0.24 (geocoding; https://github.com/TimUx/OpenEventHub)

# Monitoring overlay (docker/monitoring) — Grafana via Traefik only
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_change_me

# ---------------------------------------------------------------------------
# Optional host ports (NOT published by default)
# Enable with: -f docker/compose/docker-compose.dev-ports.yml
# ---------------------------------------------------------------------------
# POSTGRES_PORT=15432
# REDIS_PORT=16379
# S3_API_PORT=18333
# SEAWEED_ADMIN_PORT=23646
