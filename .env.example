# OpenEventHub Environment Template
# Copy to `.env` before starting Compose. Never commit real secrets.

COMPOSE_PROJECT_NAME=openeventhub

# Public hostnames (Traefik routers)
DOMAIN=localhost
ACME_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_USER=openeventhub
POSTGRES_PASSWORD=openeventhub_change_me
POSTGRES_DB=openeventhub
# Host publish ports use non-default values to avoid local conflicts.
# Containers always talk on the Docker network using service names.
POSTGRES_PORT=15432
# Prisma / local tooling (host → published Postgres port)
DATABASE_URL=postgresql://openeventhub:openeventhub_change_me@localhost:15432/openeventhub

# Redis
REDIS_PASSWORD=redis_change_me
REDIS_PORT=16379

# Object storage (SeaweedFS S3 API) — see ADR 0004
S3_ACCESS_KEY=openeventhub
S3_SECRET_KEY=openeventhub_change_me
S3_BUCKET=openeventhub
S3_API_PORT=18333
SEAWEED_ADMIN_PORT=23646
# In-container DNS name of the object-storage service
OBJECT_STORAGE_HOST=object-storage
OBJECT_STORAGE_PORT_INTERNAL=8333

# Traefik
TRAEFIK_DASHBOARD_PORT=18080
TRAEFIK_HTTP_PORT=8088
TRAEFIK_HTTPS_PORT=8443

# Observability defaults (used by later milestones)
LOG_LEVEL=info
NODE_ENV=development
