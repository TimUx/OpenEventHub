# OpenEventHub Environment Template
# Copy to `.env` before starting Compose. Never commit real secrets.

COMPOSE_PROJECT_NAME=openeventhub

# Public hostnames (Traefik routers)
DOMAIN=localhost
ACME_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_USER=openeventhub
POSTGRES_PASSWORD=openeventhub_change_me
POSTGRES_DB=openeventhub
POSTGRES_PORT=15432
DATABASE_URL=postgresql://openeventhub:openeventhub_change_me@localhost:15432/openeventhub

# Redis
REDIS_PASSWORD=redis_change_me
REDIS_PORT=16379

# Object storage (SeaweedFS S3 API) — see ADR 0004
S3_ACCESS_KEY=openeventhub
S3_SECRET_KEY=openeventhub_change_me
S3_BUCKET=openeventhub
S3_API_PORT=18333
SEAWEED_ADMIN_PORT=23646
OBJECT_STORAGE_HOST=object-storage
OBJECT_STORAGE_PORT_INTERNAL=8333
# fs | s3 — Compose apps set s3; local tests may use fs
OBJECT_STORAGE_ADAPTER=s3
# Optional local FS root when OBJECT_STORAGE_ADAPTER=fs
# OBJECT_STORAGE_ROOT=/tmp/openeventhub-object-storage
# Optional override for crawler plugin discovery
# PLUGINS_DIR=/app/plugins

# Secrets used only for crypto/auth bootstrapping — NOT AI provider credentials.
# AI providers (ChatGPT, Claude, Gemini, Ollama, …) are configured in Admin → AI Settings.
SETTINGS_ENCRYPTION_KEY=dev-only-change-me-settings-key
AUTH_JWT_SECRET=dev-only-change-me-auth-jwt-secret
ADMIN_BOOTSTRAP_EMAIL=admin@openeventhub.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeNow!

# Admin UI → API
NEXT_PUBLIC_API_BASE_URL=http://api.localhost:8088

# Traefik
TRAEFIK_DASHBOARD_PORT=18080
TRAEFIK_HTTP_PORT=8088
TRAEFIK_HTTPS_PORT=8443

LOG_LEVEL=info
NODE_ENV=development
