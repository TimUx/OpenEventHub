{
  "name": "@openeventhub/api",
  "version": "0.4.1",
  "private": true,
  "description": "OpenEventHub REST/GraphQL API",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --import reflect-metadata --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.12",
    "@openeventhub/ai-core": "0.4.1",
    "@openeventhub/database": "0.3.1",
    "@openeventhub/service-runtime": "0.1.0",
    "@openeventhub/shared": "0.1.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.12",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3"
  }
}
