{
  "name": "@openeventhub/plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Plugin SDK for OpenEventHub crawler connectors",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/smoke.test.ts"
  },
  "dependencies": {
    "@openeventhub/shared": "0.2.0"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
