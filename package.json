{
  "name": "openeventhub",
  "version": "0.20.1",
  "private": true,
  "description": "AI-powered open-source Event Intelligence Platform",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "validate:compose": "docker compose -f docker/compose/docker-compose.yml -f docker/compose/docker-compose.apps.yml -f docker/compose/docker-compose.ollama-gpu.yml --profile ollama --env-file .env.example config --quiet",
    "validate:stack": "docker compose -f docker/stack/docker-stack.yml -f docker/stack/docker-stack.ollama.yml -f docker/stack/docker-stack.ollama-gpu.yml --env-file .env.example config --quiet",
    "validate:monitoring": "docker compose -f docker/monitoring/docker-compose.monitoring.yml --env-file .env.example config --quiet",
    "restore:dry-run": "bash scripts/restore-dry-run.sh",
    "verify:plugins": "bash scripts/verify-plugins.sh",
    "backup": "bash scripts/backup.sh",
    "e2e:smoke": "bash scripts/e2e-smoke.sh",
    "perf:smoke": "bash scripts/perf-smoke.sh",
    "infra:up": "bash scripts/oeh-compose.sh -f docker/compose/docker-compose.yml --env-file .env up -d",
    "infra:down": "bash scripts/oeh-compose.sh -f docker/compose/docker-compose.yml -f docker/compose/docker-compose.apps.yml --env-file .env down",
    "infra:ps": "bash scripts/oeh-compose.sh -f docker/compose/docker-compose.yml -f docker/compose/docker-compose.apps.yml --env-file .env ps",
    "infra:logs": "bash scripts/oeh-compose.sh -f docker/compose/docker-compose.yml -f docker/compose/docker-compose.apps.yml --env-file .env logs -f --tail=200",
    "infra:health": "bash scripts/check-infra-health.sh",
    "infra:bootstrap": "bash scripts/bootstrap-infra.sh",
    "apps:up": "bash scripts/oeh-compose.sh -f docker/compose/docker-compose.yml -f docker/compose/docker-compose.apps.yml --env-file .env up -d --build",
    "apps:health": "bash scripts/check-apps-health.sh",
    "stack:up": "npm run apps:up && npm run apps:health",
    "tools:lint": "bash scripts/run-in-node.sh 'npm ci && npm run lint'",
    "tools:test": "bash scripts/run-in-node.sh 'npm ci && npm run build && npm test'",
    "tools:check": "bash scripts/run-in-node.sh 'npm ci && npm run db:generate && npm run format:check && npm run lint && npm run typecheck && npm test'",
    "db:generate": "npm run generate --workspace=@openeventhub/database",
    "db:migrate": "npm run migrate --workspace=@openeventhub/database",
    "db:seed": "npm run seed --workspace=@openeventhub/database",
    "db:seed:demo": "npx tsx packages/database/prisma/seed-demo-events.ts",
    "db:studio": "npm run studio --workspace=@openeventhub/database",
    "screenshots:ui": "bash scripts/capture-ui-screenshots.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
